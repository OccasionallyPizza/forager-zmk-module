#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
//adding to enable me to update :D
#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro
#define MEH LS(LC(LALT))

/ {
    compatible = "zmk,conditional-layers";
    tri_layer {
        if-layers = <1 2>;
        then-layer = <3>;
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE QWERTY (Standard Windows/Linux layout)
        // Use this for your daily typing.
        base {
            bindings = <
            &kp Q           &kp W           &kp E           &kp R           &kp T                                           &kp Y           &kp U           &kp I           &kp O           &kp P
            &kp A           &kp S           &kp D           &kp F           &kp G                                           &kp H           &kp J           &kp K           &kp L           &kp SEMI
            &kp Z           &kp X           &kp C           &kp V           &kp B                                           &kp N           &kp M           &kp COMMA       &kp DOT         &kp SLASH
                                             &sym_bspc 2 0   &smart_shift    &smart_shift    &lt NAV SPACE
            >;
        };

        // LAYER 1: NAVIGATION (Arrows, Page Up/Down, Tab)
        nav {
            bindings = <
            &trans          &trans          &trans          &trans          &trans                                          &kp PAGE_UP     &kp LC(PG_UP)   &kp UP          &kp LC(PG_DN)   &kp DELETE
            &trans          &kp LCTRL       &kp LALT        &kp LGUI        &trans                                          &kp PAGE_DOWN   &kp LEFT        &kp DOWN        &kp RIGHT       &kp BSLH
            &trans          &trans          &trans          &trans          &trans                                          &trans          &kp HOME        &kp END         &kp LC(SPACE)   &kp LC(SPACE)
                                             &mo SYM         &kp LSHFT       &trans          &trans
            >;
        };

        // LAYER 2: SYMBOLS & NUMBERS
        sym {
            bindings = <
            &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                                          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
            &kp GRAVE       &sk LCTRL       &sk LALT        &sk LGUI        &sk LC(LALT)                                    &kp BSLH        &kp MINUS       &kp EQUAL       &kp LBKT        &kp RBKT
            &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &kp ENTER
                                             &trans          &trans          &kp LSHFT       &mo NAV
            >;
        };

        // LAYER 3: ADJ / OS-SWAP (The "Mac" Mode)
        // When you activate this layer, the roles of LGUI and LALT are swapped.
        adj {
            bindings = <
            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR_ALL                                  &kp C_SLEEP     &trans          &trans          &kp C_BRI_DN    &kp C_BRI_UP
            &studio_unlock  &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &kp C_VOL_DN    &kp C_VOL_UP
            &bootloader     &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &bootloader
            // SWAP LOGIC: 
            // If L_CORNER was LGUI and L_THUMB was LALT... 
            // Now L_CORNER is LALT and L_THUMB is LGUI.
            &kp LALT        &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &kp C_BRI_DN    &kp C_BRI_UP
            >;
        };
    };
};

// Behavior configurations preserved from your original build
&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <200>;
};

&mt {
    quick-tap-ms = <200>;
};

&sk {
    release-after-ms = <500>;
    quick-release;
};
